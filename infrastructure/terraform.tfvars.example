# Example Terraform variables file
# Copy this to terraform.tfvars and update with your actual values

aws_region = "us-west-2"

# VPC and subnet configuration
vpc_id             = "vpc-xxxxxxxxx"  # Replace with your VPC ID
public_subnet_ids  = ["subnet-xxxxxxxxx", "subnet-yyyyyyyyy"]   # Replace with your public subnet IDs
private_subnet_ids = ["subnet-zzzzzzzzz", "subnet-aaaaaaaaa"]   # Replace with your private subnet IDs

# ECS cluster configuration
proxy_cluster_name   = "my-proxy-cluster"
web_cluster_name     = "my-web-cluster"
proxy_instance_type  = "t3.medium"

# Environment
environment = "production"

# Site configurations
sites = [
  {
    name        = "site1"
    domain      = "example1.com"
    environment = "production"
  },
  {
    name        = "site2"
    domain      = "example2.com"
    environment = "staging"
  }
]

# Database configuration (optional)
db_host = "my-database.region.rds.amazonaws.com"
db_name = "myapp"